# Copy to the repo-root .env (gitignored) and fill in. agent/.env also works.
# Without a key every LLM agent uses its deterministic fallback.

# anthropic | gemini | openai | ollama   (pip install anthropic | google-genai | openai | openai)
LLM_PROVIDER=ollama
LLM_API_KEY=

# Model for the chosen provider (blank = provider default)
LLM_MODEL=gpt-oss:120b

# ollama only: OpenAI-compatible base URL (Ollama Cloud). Native /api/chat on the same host is the fallback.
LLM_BASE_URL=https://ollama.com/v1

# Set to 1 to skip the LLM entirely and force the fallbacks
CHAOS_NO_LLM=
