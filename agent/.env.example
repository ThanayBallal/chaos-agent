# Copy to the repo-root .env (gitignored) and fill in. agent/.env also works.
# Without a key the planner and analyst use their deterministic fallbacks.

# anthropic | gemini | openai | ollama   (pip install anthropic | google-genai | openai | openai)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Model for the chosen provider (blank = provider default; ollama default gpt-oss:120b)
LLM_MODEL=gemini-3.8-flash

# ollama only: OpenAI-compatible base URL (Ollama Cloud default). Native /api/chat on the same host is the fallback.
# LLM_BASE_URL=https://ollama.com/v1

# Set to 1 to skip the LLM entirely and force the fallbacks
CHAOS_NO_LLM=
