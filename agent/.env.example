# Copy to the repo-root .env (gitignored) and fill in. agent/.env also works.
# Without a key the planner and analyst use their deterministic fallbacks.

# anthropic | gemini | openai   (pip install anthropic | google-genai | openai)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Model for the chosen provider (blank = provider default)
LLM_MODEL=gemini-3.8-flash

# Set to 1 to skip the LLM entirely and force the fallbacks
CHAOS_NO_LLM=
