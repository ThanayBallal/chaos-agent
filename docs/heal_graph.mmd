config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	understand(understand)
	chaos_agent(chaos_agent)
	guard_approve(guard_approve)
	inject(inject)
	observe(observe)
	diagnosis_agent(diagnosis_agent)
	remediation_agent(remediation_agent)
	apply_fix(apply_fix)
	verify(verify)
	guard_revert(guard_revert)
	harden_agent(harden_agent)
	apply_hardening(apply_hardening)
	rerun(rerun)
	compare(compare)
	revert_patch(revert_patch)
	report(report)
	__end__([<p>__end__</p>]):::last
	__start__ --> understand;
	apply_fix --> verify;
	apply_hardening -. &nbsp;stop&nbsp; .-> guard_revert;
	apply_hardening -. &nbsp;ok&nbsp; .-> rerun;
	chaos_agent --> guard_approve;
	compare -. &nbsp;done&nbsp; .-> guard_revert;
	compare -. &nbsp;round2&nbsp; .-> revert_patch;
	diagnosis_agent --> remediation_agent;
	guard_approve -. &nbsp;approved&nbsp; .-> inject;
	guard_approve -. &nbsp;rejected&nbsp; .-> report;
	guard_revert --> report;
	harden_agent -. &nbsp;apply&nbsp; .-> apply_hardening;
	harden_agent -. &nbsp;skip&nbsp; .-> guard_revert;
	inject -. &nbsp;abort&nbsp; .-> guard_revert;
	inject -. &nbsp;ok&nbsp; .-> observe;
	observe -. &nbsp;ok&nbsp; .-> diagnosis_agent;
	observe -. &nbsp;abort&nbsp; .-> guard_revert;
	remediation_agent --> apply_fix;
	rerun --> compare;
	revert_patch --> harden_agent;
	understand --> chaos_agent;
	verify -. &nbsp;give_up&nbsp; .-> guard_revert;
	verify -. &nbsp;healed&nbsp; .-> harden_agent;
	verify -. &nbsp;retry&nbsp; .-> observe;
	report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
